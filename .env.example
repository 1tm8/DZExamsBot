# انسخ هذا الملف إلى .env وعدّل القيم
# cp .env.example .env

# ─── إلزامي ─────────────────────────────────────────────
# رمز البوت من @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# معرف تيليغرام الخاص بك (لأوامر المشرفين) من @userinfobot
ADMIN_IDS=123456789

# ─── اختياري ────────────────────────────────────────────
# الفهرسة التلقائية اليومية (مستويات مفصولة بفواصل، فارغة = معطلة)
AUTO_INDEX_LEVELS=bac,bem
AUTO_INDEX_HOUR=3

# إيقاع الطلبات (كن لطيفًا مع الموقع)
REQ_MIN_INTERVAL=1.2
MAX_CONCURRENT_REQUESTS=1

# ─── تدوير IP عند الحجب ─────────────────────────────────
# warp-cli (العميل الرسمي) يُكتشف تلقائيًا إن كان مثبتًا
# WARP_CLI_PATH=/usr/bin/warp-cli

# ملفات WireGuard المولّدة بـ wgcf (تدوير دوري بينها)
WARP_WG_PROFILES=/etc/wireguard/warp*.conf

# بروكسي بديلة (HTTP/SOCKS5) مفصولة بفواصل — آخر حلقة أمان
# PROXY_LIST=socks5://user:pass@host:1080,http://host:8080

# عتبة الحجب المتتالي قبل تشغيل تدوير IP
WARP_FAIL_THRESHOLD=3

# ─── متصفح التحقق (اختياري) ─────────────────────────────
PLAYWRIGHT_ENABLED=0
PLAYWRIGHT_HEADLESS=1

# ─── ملفات ──────────────────────────────────────────────
DB_PATH=dzexams.db
TMP_DIR=/tmp/dzexams_bot
