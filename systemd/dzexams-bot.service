[Unit]
Description=DzExams Telegram Bot (Rust)
After=network-online.target warp-svc.service
Wants=network-online.target

# إعادة تشغيل آمنة عند الأعطال المتكررة
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# تشغيل بلا صلاحيات root — أنشئ المستخدم وملّكه المجلد أولًا:
#   useradd -m botuser && chown -R botuser:botuser /opt/dzexams-bot
# ثبّت الملف التنفيذي في /opt/dzexams-bot/dzexams-bot
# ملاحظة: تدوير WARP عبر wg-quick يحتاج root؛ بدون WARP لا أثر لهذا.
User=botuser
Group=botuser
WorkingDirectory=/opt/dzexams-bot
ExecStart=/opt/dzexams-bot/dzexams-bot
Restart=always
RestartSec=10
# متغيرات البيئة (أو استخدم ملف .env في مجلد المشروع)
EnvironmentFile=-/opt/dzexams-bot/.env

# تصليب: بلا امتيازات جديدة، نظام ملفات للقراءة فقط إلا مجلد البوت
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/dzexams-bot

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dzexams-bot

[Install]
WantedBy=multi-user.target
